# SSH key generated for the Steam-Linux VM by Deploy.sh
ssh_keys/

# Site-specific config — real node names/IPs, storage/bridge names,
# internal CIDRs. This repo is public; only the matching .example files
# (with placeholder/generic values) are committed. Copy an .example to its
# real name and fill it in — see README.md. (ansible.cfg is copied from
# ../Shared/Ansible/ansible.cfg.example, the one canonical example.)
ansible.cfg
inventory/hosts.ini
inventory/group_vars/steam_linux/vars.yaml

# Shared cluster/node settings (node, storage, template, backup target) —
# NOT under this project's inventory/ at all anymore; see
# ../Shared/Ansible/group_vars/proxmox_pve1/vars.yaml.example. Its real
# file is gitignored there, not here.

# Real VMs' connection details, generated by create_steam_vm — carries a
# real IP, not committed. .gitkeep keeps the directory itself tracked.
inventory/host_vars/*.yaml
!inventory/host_vars/.gitkeep

# Per-instance game-server vars files are gitignored by default — most
# real instances carry a join password or other value you won't want in
# a public repo, and there's no vault for this project (see README.md
# "Known limitations"). hlds-dm01.vars.yaml is the sole, deliberate
# exception: anonymous SteamCMD login, no secret of any kind, safe to
# commit as the one worked example. Add your own !<name>.vars.yaml
# exception only if you've actually checked it holds nothing sensitive.
gameservers/*.vars.yaml
!gameservers/hlds-dm01.vars.yaml

# Ansible artifacts
*.retry
