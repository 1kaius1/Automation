---
# Configuration for create-template-linux.yaml. This repo is public —
# the real template_configuration.yaml is gitignored (see .gitignore);
# copy this file to that name and fill in your own values.
#
# One run of create-template-linux.yaml builds ONE template — the one
# named by template_target below. To build every template still missing
# from template_manifest.yaml in a single pass, run ./create-templates_from_manifest.sh
# instead (it invokes this playbook once per manifest row).

# ============================================
# Where to build it
# ============================================

# Which cluster node this template gets built on. Must be the Proxmox
# node *name* (as the API reports it), not an IP or FQDN.
template_target_node: "REPLACE_ME_NODE_NAME"

# Storage pool for the template's disk.
template_storage_pool: "REPLACE_ME_STORAGE_POOL"

# Network bridge for the (temporary, deleted-after-templating) build VM.
# This must attach to the dedicated build VLAN described below.
template_network_bridge: "vmbr0"

# The build VLAN. This is expected to be a dedicated /24 that ONLY this
# pipeline (and any ISO/Packer build flow) ever uses — just-in-time
# outbound internet for a build VM, never anything on a production VLAN,
# so there is nothing to collide with.
#
# The build VM's OWN address is NOT set here — it is DERIVED from this
# subnet and the template's VMID:
#     <subnet first three octets>.<(vmid - 90000) % 220 + 20>/24
# i.e. the .20-.239 host range. VMIDs are globally unique, so 5-10 (or
# more) builds running at once each get a distinct address with no DHCP
# server, no IPAM and no lock. Must be a /24. The build VM needs an
# address only for the few minutes between boot and templating (cloud
# images run no QEMU guest agent, so a DHCP lease can't be discovered
# from outside); it's released when the build VM is deleted.
template_build_subnet: "192.168.90.0/24"
template_build_gateway: "192.168.90.1"

# DNS for the build VM. First boot resolves package mirrors, so this must
# work from the build VLAN.
template_build_nameservers: ["1.1.1.1", "9.9.9.9"]

# Dir-type Proxmox storage the playbook writes the build VM's per-run
# cloud-init network snippet to (and points `qm set --cicustom network=`
# at). Proxmox only emits the legacy cloud-init network-config v1 via
# ipconfig0, which Ubuntu 26.04 / Rocky / Arch cloud-init ignore; a
# netplan-v2 snippet applies reliably everywhere. create-pve_svc_user.yaml
# enables `snippets` content on this storage and makes its snippets/ dir
# writable by svc_ansible — keep this equal to pve_svc_snippet_storage there.
template_snippet_storage: "local"

# ============================================
# Disk layout (see Shared/Ansible/README.md "Disk layout & growing a
# template's disks" for how to enlarge either disk on a clone)
# ============================================

# ABSOLUTE size of the root disk (scsi0) — the OS only. Apps and their
# data/logs go on the /opt disk below. The imported cloud image's root
# is resized to exactly this before first boot IF it is currently
# smaller; it is NEVER shrunk (xfs can't shrink, and an absolute
# `qm disk resize` to a smaller value errors). Suffix M or G, no leading
# "+". cloud-init's growpart/resizefs expand the partition + filesystem
# to match on first boot.
#   Rocky GenericCloud is already 10G  -> grown to this.
#   Debian / Ubuntu / Arch ship ~2-3.5G -> grown to this.
# Bump to 24G before adding an openSUSE/SLES template (btrfs + snapper).
template_root_size: "16G"

# Second virtual disk, attached as scsi1 and mounted at /opt in every
# template. Holds exactly /opt/app (applications) and /opt/data
# (application data AND logs). Size in GiB, bare integer. It's a whole-
# disk filesystem (no partition table) and carries the x-systemd.growfs
# mount option, so a consuming project that resizes scsi1 on its clone
# gets a bigger /opt on the next boot with no in-guest step. On an
# LVM-thin pool this costs almost nothing until data is written; for a
# space-guaranteed / low-latency DB VM, clone onto a NON-thin storage
# (LVM-thin has no thick toggle) — see the README.
template_opt_size_gb: 16

# Filesystem for the /opt disk: "xfs" or "ext4".
#   xfs (default): Red Hat's default; scales better under concurrent
#     writers (databases), large files and streaming, and reflink copies.
#     The playbook installs xfsprogs where it's missing (Debian/Ubuntu and
#     the minimal Arch image; EL ships it). xfs cannot be shrunk (fine for
#     a data disk) and wants ~10-15% free space.
#   ext4: mkfs.ext4 is on every image already; fine for /opt at this
#     scale; shrinkable only offline.
template_opt_fstype: "xfs"

# Persistent cache directory ON THE NODE for downloaded cloud images and
# their checksum sidecars. The playbook validates a cached image against
# its sidecar before downloading, so a template can be rebuilt with no
# internet traffic once the image is cached. Created by
# create-pve_svc_user.yaml (as pve_svc_cache_dir — keep the two equal if
# you change this). Pass -e refresh_image_cache=true to force a re-download.
template_image_cache_dir: "/var/cache/vm-template-images"

# ============================================
# CPU model
# ============================================

# QEMU CPU model for `qm create --cpu`, baked into the template and
# inherited by clones. Leave BLANK to use the per-OS default from
# os_catalog in the playbook:
#   Debian / Ubuntu / Arch / Rocky 9 / RHEL 9 -> x86-64-v2-AES
#   Rocky 10 / RHEL 10                         -> x86-64-v3
# Do NOT leave Proxmox on its own default (kvm64 = x86-64-v1): RHEL/Rocky
# 9+ kernels PANIC on boot on v1. x86-64-v2 needs any host CPU since
# ~2013 (Nehalem/Jaguar); x86-64-v3 needs Haswell/Zen or newer (AVX2),
# so an older build host cannot build the EL10 templates at all. Set to
# "host" for best performance on a single-node setup where you never
# live-migrate to different silicon; set to a specific model
# (e.g. "x86-64-v3", "SandyBridge") to pin a migration-safe baseline.
template_cpu_type: ""

# Templates for create-templates_from_manifest.sh to SKIP in this environment. It
# prints "skipped (template_skip)" and does NOT count them as failures.
# Use it for manifest rows that can't be built on this cluster for host
# reasons — e.g. an x86-64-v3 template (Rocky/RHEL 10) on a pre-Haswell
# node. A direct `ansible-playbook ... -e template_target=<name>` still
# runs it (the playbook's CPU pre-flight then fails it fast if the node
# genuinely can't provide the model). Leave empty to build everything.
template_skip: []
#   - "T-Rocky-10-Cloud"

# ============================================
# What to build
# ============================================

# Which template to build this run. Must be the exact `name` of a
# manifest row (shape: "T-<Os>-<Version>-<Source>[-<Variant>]"). The
# manifest is the source of truth: OS, version, VMID and final template
# name all come from that row. This playbook only builds "-Cloud" rows.
template_target: "T-Debian-13-Cloud"

# ============================================
# sysadmin account baked into the template
# ============================================

# Public key only — this is not secret, safe to commit for real if you
# want to, though the .example convention here keeps it generic too.
# Used for BOTH the template's baked-in sysadmin account AND (by
# create-pve_svc_user.yaml) the svc_ansible account on the Proxmox nodes.
sysadmin_ssh_public_key: "REPLACE_ME_SSH_PUBLIC_KEY"

# The initial local-console password for sysadmin (SSH access is
# key-only regardless — see create-template-linux.yaml's own comments
# for why this still matters). Defined in the sibling
# template_configuration_vault.yaml, referenced here — see
# template_configuration_vault.yaml.example.
sysadmin_initial_password: "{{ vault_sysadmin_initial_password }}"

# ============================================
# Miscellaneous hardening
# ============================================

# Mask systemd-ssh-generator inside the template. This generator probes
# for an AF_VSOCK transport on every boot/daemon-reload to decide whether
# to offer SSH-over-vsock; VMs built by this playbook never have a vsock
# device attached, so the probe always fails and logs a harmless but
# noisy "Failed to determine the local CID: Cannot assign requested
# address". Masking it (symlinking it to /dev/null, the systemd-
# documented way to disable a generator) stops the probe from running at
# all. Set to false only if you specifically want vsock-based local SSH
# access (see systemd-ssh-generator(8)) and plan to attach a vsock
# device to VMs cloned from this template.
template_mask_ssh_generator: true
