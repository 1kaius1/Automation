# This repo is public. proxmox_api_host in the real vars.yaml identifies
# your actual cluster — only the .example (placeholder values) is committed.
# The real file is generated by create-pve_svc_user.yaml.
group_vars/proxmox_cluster/vars.yaml

# Optional personal vault-id label/filename — see ansible.cfg.example.
ansible.cfg

# create-template-linux.yaml's non-secret config — real node/storage/bridge
# names and an SSH key are personal to your cluster.
template_configuration.yaml

# Ansible Vault ciphertext files. Even encrypted, the header is cleartext
# — `$ANSIBLE_VAULT;1.2;AES256;<vault-id>` — and that <vault-id> label
# names a credential on a real network. Both real vault files here are
# generated locally by create-pve_svc_user.yaml / `ansible-vault create`;
# only their *.example companions (plaintext placeholders) are committed.
group_vars/proxmox_cluster/vault.yaml
template_configuration_vault.yaml

# The inventory has real Proxmox node names + IPs. Only the .example
# (placeholder values) is committed; copy it to hosts.ini and fill in.
inventory/hosts.ini
